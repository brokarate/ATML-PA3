{
  "seed": 6304,
  "backend": {
    "selection": "PA3_DEVICE or --device; auto selects CUDA when available, otherwise MPS",
    "mps_attention": "eager",
    "mps_exact_svd_device": "cpu, FP32, no randomized approximation",
    "mps_gradient_scaler": "native torch.amp.GradScaler(mps), enabled",
    "mps_memory_measurement": "sampled tensor/driver high-water marks, lower bounds",
    "mps_memory_sampling_interval_seconds": 0.01,
    "automatic_cpu_training_fallback": false
  },
  "task1": {
    "model": "Qwen/Qwen3-0.6B", "thinking": false,
    "examples": 40000, "updates": 1250, "epochs": 1,
    "microbatch": 2, "accumulation": 16, "max_length": 2048,
    "betas": [0.9, 0.999], "eps": 1e-8, "weight_decay": 0.01,
    "warmup": 38, "schedule": "cosine to zero", "clip": 1.0,
    "precision": "FP16 autocast, FP32 master trainable parameters and optimizer states",
    "checkpoint_updates": [312, 625, 937, 1250],
    "methods": {"full": {"lr": 2e-5}, "l2sp": {"lr": 2e-5, "lambda": 0.001},
      "lora4": {"lr": 2e-4, "r": 4, "alpha": 8},
      "lora16": {"lr": 2e-4, "r": 16, "alpha": 32},
      "oplora16": {"lr": 2e-4, "r": 16, "alpha": 32, "k": 128}},
    "dropout": 0.05, "targets": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "gsm8k_max_new_tokens": 1024, "qualitative_max_new_tokens": 512,
    "diagnostic_layers": [0, 13, 27], "probe_examples_per_task": 32
  },
  "task2": {
    "encoder": "google/siglip-base-patch16-224", "model": "Qwen/Qwen3-0.6B",
    "connector": [768, 1024, 1024], "visual_tokens": 196,
    "microbatch": 8, "accumulation": 2, "updates": [2250, 1500, 750],
    "connector_lrs": [0.001, 0.0001, 0.00005], "adapter_lrs": [null, 0.00002, 0.00001],
    "warmup_fraction": 0.05, "cosine_floor": 0.1, "weight_decay": 0.01,
    "clip": 1.0, "caption_examples": 18000, "caption_passes": 2,
    "content_caps": {"question": 80, "caption": 64, "answer": 16},
    "adapter_rank": 16, "adapter_alpha": 32, "adapter_dropout": 0.05,
    "adapter_targets": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "stage2_draws": {"presence": 0.5, "counting": 0.25, "caption": 0.25},
    "stage3_draws": {"natural": 0.7, "presence": 0.1, "counting": 0.1, "caption": 0.1},
    "bootstrap_pairs": 4000, "generation_batch": 8, "max_new_tokens": 16
  },
  "task3": {
    "questions_per_dataset": 1000, "development": 200, "evaluation": 800,
    "live_questions": 50, "rollouts": 32, "orders": 10,
    "budgets": [1, 2, 4, 8, 16, 32], "bootstrap_questions": 1000,
    "temperature": 0.7, "top_p": 0.8, "top_k": 20, "repetition_penalty": 1.0,
    "live_output_caps": {"long": [3072], "parallel": [1024, 1024, 1024], "refinement": [1024, 2048]},
    "stop_checks": [4, 8, 16], "tau": [0.5, 0.625, 0.75, 0.875, 1.0],
    "gamma": [0, 0.1, 0.25, 0.5], "accuracy_tolerance": 0.01
  }
}
